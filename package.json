{
  "name": "biz-utils",
  "version": "0.3.8",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run docs:dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:cov": "pnpm -r run test:cov",
    "release": "changeset publish",
    "tsc": "pnpm -r run tsc",
    "docs:pages": "gh-pages -d docs-dist -b gh-pages",
    "docs:apis": "typedoc --options ./typedoc.json",
    "docs:release": "npm run docs:apis && npm run docs:build && npm run docs:pages",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "docs:build": "vitepress build docs",
    "cs": "changeset"
  },
  "devDependencies": {
    "@bizjs/biz-utils": "workspace:*",
    "@changesets/cli": "^2.31.0",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.2.0",
    "@types/react": "^19.2.17",
    "@types/uuid": "^8.3.4",
    "@types/validator": "^13.15.10",
    "antd": "^6.4.3",
    "cross-env": "^10.1.0",
    "father": "^4.6.22",
    "fs-extra": "^11.3.5",
    "gh-pages": "^6.3.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ts-jest": "^29.4.11",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.4.5",
    "vitepress": "^1.6.4",
    "vitepress-demo-plugin": "^1.5.1"
  }
}
